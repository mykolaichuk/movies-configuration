// markdownlint-cli2 configuration for this repository.
{
  "config": {
    "default": true,
    // Prose wraps at 80 characters. Tables and code blocks cannot wrap
    // without breaking their rendering, so they are exempt.
    "MD013": {
      "line_length": 80,
      "tables": false,
      "code_blocks": false
    }
  }
}
