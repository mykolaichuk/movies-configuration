# {{ ansible_managed }}
# Non-secret settings from Terraform outputs. Secrets (TMDB token, session
# secret, Entra client secret) are read from Key Vault by the app itself.

NODE_ENV=production
HOST=127.0.0.1
PORT={{ movies_app_port }}
PUBLIC_URL=https://{{ domain_name }}

# DefaultAzureCredential -> the VM's user-assigned managed identity
AZURE_CLIENT_ID={{ app_identity.client_id }}

KEY_VAULT_URI={{ key_vault.uri }}

SQL_SERVER={{ sql.server_fqdn }}
SQL_DATABASE={{ sql.database }}

STORAGE_BLOB_URL={{ storage.blob_url }}
STORAGE_QUEUE_URL={{ storage.queue_url }}
STORAGE_TABLE_URL={{ storage.table_url }}
STORAGE_QUEUE_NAME={{ storage.queue }}
STORAGE_TABLE_NAME={{ storage.table }}

# Admin sign-in (Entra ID, confidential client; the secret is in Key Vault)
ENTRA_TENANT_ID={{ entra_app.tenant_id }}
ENTRA_CLIENT_ID={{ entra_app.client_id }}
ENTRA_REDIRECT_URI={{ entra_app.redirect_uri }}
# Everyone allowed into /admin, comma-separated. ADMIN_OBJECT_ID stays for
# app releases that predate ADMIN_OBJECT_IDS (and for stack outputs without it).
ADMIN_OBJECT_IDS={{ entra_app.admin_object_ids | default([entra_app.admin_object_id]) | join(',') }}
ADMIN_OBJECT_ID={{ entra_app.admin_object_id }}

# Ingestion also needs an Entra token (local auth is disabled)
APPLICATIONINSIGHTS_CONNECTION_STRING={{ monitoring.app_insights_connection_string }}
